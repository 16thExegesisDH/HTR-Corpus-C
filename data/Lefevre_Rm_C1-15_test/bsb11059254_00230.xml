            <String CONTENT="ſia aſtringitur ſponſo ſuo Chriſto. Verum quia ancilla non potuit ha" HPOS="875.0" VPOS="1553.0" WIDTH="1247.0" HEIGHT="64.0" WC="0.9973810700809255"/>
          </TextLine>
          <TextLine ID="line_35" TAGREFS="LT8" BASELINE="550 1639 2120 1633" HPOS="548.0" VPOS="1599.0" WIDTH="1572.0" HEIGHT="64.0">
            <Shape><Polygon POINTS="550 1639 550 1663 2118 1653 2120 1633 2114 1599 548 1603 550 1639"/></Shape>
            <String CONTENT="bere virum niſi moreretur! &amp; in meliorem &amp; incontaminatam ſurgeret vitam: ideo pri" HPOS="548.0" VPOS="1599.0" WIDTH="1572.0" HEIGHT="64.0" WC="0.9970039187408075"/>
          </TextLine>
          <TextLine ID="line_36" TAGREFS="LT8" BASELINE="550 1683 2122 1683" HPOS="550.0" VPOS="1645.0" WIDTH="1572.0" HEIGHT="56.0">
            <Shape><Polygon POINTS="550 1683 550 1699 2120 1701 2122 1683 2120 1645 550 1649 550 1683"/></Shape>
            <String CONTENT="uſq̃ Chriſtum ſponſum habere poſſit! in baptiſmate moritur! &amp; pariter omnes priſcæ cõ" HPOS="550.0" VPOS="1645.0" WIDTH="1572.0" HEIGHT="56.0" WC="0.9841520259546679"/>
          </TextLine>
          <TextLine ID="line_37" TAGREFS="LT8" BASELINE="550 1731 2120 1725" HPOS="548.0" VPOS="1693.0" WIDTH="1572.0" HEIGHT="60.0">
            <Shape><Polygon POINTS="550 1731 550 1753 2118 1743 2120 1725 2114 1693 548 1697 550 1731"/></Shape>
            <String CONTENT="ſuetudinis labes abſterguntur. &amp; ex morte in nouam &amp; candidiſſimam reſurgit vitam," HPOS="548.0" VPOS="1693.0" WIDTH="1572.0" HEIGHT="60.0" WC="0.9945220111346826"/>
          </TextLine>
          <TextLine ID="line_38" TAGREFS="LT8" BASELINE="552 1773 2120 1769" HPOS="550.0" VPOS="1739.0" WIDTH="1570.0" HEIGHT="54.0">
            <Shape><Polygon POINTS="552 1773 552 1791 2116 1793 2120 1769 2114 1739 550 1741 552 1773"/></Shape>
            <String CONTENT="non amplius ancilla: ſed libera. non amplius ſerua: ſed dominal quæ ſponſum habet." HPOS="550.0" VPOS="1739.0" WIDTH="1570.0" HEIGHT="54.0" WC="0.9947864144313626"/>
          </TextLine>
          <TextLine ID="line_39" TAGREFS="LT8" BASELINE="552 1820 2118 1812" HPOS="550.0" VPOS="1781.0" WIDTH="1568.0" HEIGHT="61.0">
            <Shape><Polygon POINTS="552 1820 552 1842 2116 1830 2118 1812 2114 1781 550 1781 552 1820"/></Shape>
            <String CONTENT="Et ideo alterius vitæ peccata: nullo modo ei reputantur. nullum illius ſignum habeti" HPOS="550.0" VPOS="1781.0" WIDTH="1568.0" HEIGHT="61.0" WC="0.9964263510136377"/>
          </TextLine>
          <TextLine ID="line_40" TAGREFS="LT8" BASELINE="552 1862 2120 1856" HPOS="550.0" VPOS="1824.0" WIDTH="1570.0" HEIGHT="62.0">
            <Shape><Polygon POINTS="552 1862 552 1886 2118 1878 2120 1856 2114 1824 550 1830 552 1862"/></Shape>
            <String CONTENT="nullum veſtigium. ꝙ ſi ancilla iuſtitiæ ſerua iuſtitiæl ancilla Chriſti ſerua Chriſti dici¬" HPOS="550.0" VPOS="1824.0" WIDTH="1570.0" HEIGHT="62.0" WC="0.9825562716840388"/>
          </TextLine>
          <TextLine ID="line_41" TAGREFS="LT8" BASELINE="550 1908 2124 1900" HPOS="548.0" VPOS="1862.0" WIDTH="1576.0" HEIGHT="64.0">
            <Shape><Polygon POINTS="550 1908 550 1926 2122 1920 2124 1900 2118 1862 548 1876 550 1908"/></Shape>
            <String CONTENT="tur: hæc eſt vera libertas | &amp; dominatio veralet eam reuera eſſe liberã &amp; dominam. Sed" HPOS="548.0" VPOS="1862.0" WIDTH="1576.0" HEIGHT="64.0" WC="0.9775573114554087"/>
          </TextLine>
          <TextLine ID="line_42" TAGREFS="LT8" BASELINE="552 1950 2124 1946" HPOS="550.0" VPOS="1914.0" WIDTH="1574.0" HEIGHT="60.0">
            <Shape><Polygon POINTS="552 1950 552 1974 2122 1964 2124 1946 2118 1914 550 1918 552 1950"/></Shape>
            <String CONTENT="quia adhuc adoleſcentula et tantilla eſt: educatur in lege viri ſuil vſ dũ adulta de an¬" HPOS="550.0" VPOS="1914.0" WIDTH="1574.0" HEIGHT="60.0" WC="0.9926033854484558"/>
          </TextLine>
          <TextLine ID="line_43" TAGREFS="LT8" BASELINE="554 1994 2126 1990" HPOS="552.0" VPOS="1952.0" WIDTH="1574.0" HEIGHT="68.0">
            <Shape><Polygon POINTS="554 1994 554 2020 2124 2012 2126 1990 2120 1952 552 1962 554 1994"/></Shape>
            <String CONTENT="guſtijs mundi huius in ampliſſimum cœli thalamum occurrat viro ſuo. vbi fruatur ſpõ" HPOS="552.0" VPOS="1952.0" WIDTH="1574.0" HEIGHT="68.0" WC="0.9910620564506167"/>
          </TextLine>
          <TextLine ID="line_44" TAGREFS="LT8" BASELINE="552 2036 2128 2036" HPOS="552.0" VPOS="2006.0" WIDTH="1576.0" HEIGHT="52.0">
            <Shape><Polygon POINTS="552 2036 552 2058 2128 2058 2128 2036 2128 2006 552 2006 552 2036"/></Shape>
            <String CONTENT="ſo ſuo: in delicijs paradiſi, fruatur inq̃ ſponſo ſuo: cuius viſio beatificat! cuius amplexus" HPOS="552.0" VPOS="2006.0" WIDTH="1576.0" HEIGHT="52.0" WC="0.9871245968726373"/>
          </TextLine>
          <TextLine ID="line_45" TAGREFS="LT8" BASELINE="550 2082 2130 2082" HPOS="550.0" VPOS="2050.0" WIDTH="1580.0" HEIGHT="52.0">
            <Shape><Polygon POINTS="550 2082 550 2102 2130 2100 2130 2082 2130 2050 550 2050 550 2082"/></Shape>
            <String CONTENT="ſumma caſtitas attactus ſumma puritas |et vnio vita ęterna. Verum cũ ſyna goga virũ" HPOS="550.0" VPOS="2050.0" WIDTH="1580.0" HEIGHT="52.0" WC="0.986143731793692"/>
          </TextLine>
          <TextLine ID="line_46" TAGREFS="LT8" BASELINE="550 2127 2130 2127" HPOS="550.0" VPOS="2088.0" WIDTH="1580.0" HEIGHT="63.0">
            <Shape><Polygon POINTS="550 2127 550 2151 2130 2145 2130 2127 2130 2094 550 2088 550 2127"/></Shape>
            <String CONTENT="haberet: obnoxia fuit legi viril et hoctaut q̃diu vir vixit aut q̃diu ipſa viueret. Sed eſto" HPOS="550.0" VPOS="2088.0" WIDTH="1580.0" HEIGHT="63.0" WC="0.9828128717515779"/>
          </TextLine>
          <TextLine ID="line_47" TAGREFS="LT8" BASELINE="550 2173 2132 2169" HPOS="548.0" VPOS="2137.0" WIDTH="1584.0" HEIGHT="56.0">
            <Shape><Polygon POINTS="550 2173 550 2193 2130 2193 2132 2169 2126 2137 548 2137 550 2173"/></Shape>
            <String CONTENT="Moſes vir ſynagogæ legi carnis vixerit vſ dum Chriſtus domin9 et carnem et carnis" HPOS="548.0" VPOS="2137.0" WIDTH="1584.0" HEIGHT="56.0" WC="0.9924361313261637"/>
          </TextLine>
          <TextLine ID="line_48" TAGREFS="LT8" BASELINE="552 2217 2132 2213" HPOS="550.0" VPOS="2179.0" WIDTH="1582.0" HEIGHT="62.0">
            <Shape><Polygon POINTS="552 2217 552 2241 2130 2235 2132 2213 2128 2181 550 2179 552 2217"/></Shape>
            <String CONTENT="legem mortificauit in crucel vſ dum deſcendit ad inferos et Moſem ſuæ reſurrectionis" HPOS="550.0" VPOS="2179.0" WIDTH="1582.0" HEIGHT="62.0" WC="0.9827637735535116"/>
          </TextLine>
          <TextLine ID="line_49" TAGREFS="LT8" BASELINE="552 2259 2134 2259" HPOS="552.0" VPOS="2221.0" WIDTH="1582.0" HEIGHT="60.0">
            <Shape><Polygon POINTS="552 2259 552 2281 2134 2279 2134 2259 2132 2221 552 2225 552 2259"/></Shape>
            <String CONTENT="comitẽ habuit quẽ habuit et tranſſigurationis: tunc certe Moſes non ãplius legi carnis" HPOS="552.0" VPOS="2221.0" WIDTH="1582.0" HEIGHT="60.0" WC="0.991352477100458"/>
          </TextLine>
          <TextLine ID="line_50" TAGREFS="LT8" BASELINE="552 2303 2132 2303" HPOS="552.0" VPOS="2269.0" WIDTH="1580.0" HEIGHT="54.0">
            <Shape><Polygon POINTS="552 2303 552 2323 2132 2323 2132 2303 2132 2273 552 2269 552 2303"/></Shape>
            <String CONTENT="vixit ſed legi iuſtitiæ. Qr ſi tunc nõ vixit legi carnis: mortuus illi fuit. quarè ex eo tẽpo" HPOS="552.0" VPOS="2269.0" WIDTH="1580.0" HEIGHT="54.0" WC="0.9873064445952574"/>
          </TextLine>
          <TextLine ID="line_51" TAGREFS="LT8" BASELINE="550 2349 2132 2349" HPOS="550.0" VPOS="2317.0" WIDTH="1582.0" HEIGHT="54.0">
            <Shape><Polygon POINTS="550 2349 550 2371 2132 2365 2132 2349 2132 2317 550 2317 550 2349"/></Shape>
            <String CONTENT="re ſynagoga vidua fuit et abſ viro:ne ãplius! vlli aſtricta viro. Et licebat et plane:" HPOS="550.0" VPOS="2317.0" WIDTH="1582.0" HEIGHT="54.0" WC="0.9707863109835079"/>
          </TextLine>
          <TextLine ID="line_52" TAGREFS="LT8" BASELINE="550 2393 2132 2389" HPOS="548.0" VPOS="2351.0" WIDTH="1584.0" HEIGHT="65.0">
            <Shape><Polygon POINTS="550 2393 550 2414 2128 2416 2132 2389 2126 2351 548 2361 550 2393"/></Shape>
            <String CONTENT="relicta lege viri alteri viro nubere qui etiã lõge erat Moſe nobilior. Sed o ſtulta vidua:q̃" HPOS="548.0" VPOS="2351.0" WIDTH="1584.0" HEIGHT="65.0" WC="0.990814522225806"/>
          </TextLine>
          <TextLine ID="line_53" TAGREFS="LT8" BASELINE="550 2438 2136 2438" HPOS="550.0" VPOS="2405.0" WIDTH="1586.0" HEIGHT="57.0">
            <Shape><Polygon POINTS="550 2438 550 2462 2136 2460 2136 2438 2136 2405 550 2405 550 2438"/></Shape>
            <String CONTENT="credit habere virũl cũ nõ habeat. Eſto habeat. Si ipſa moriti et ex morte redeat i vitã:" HPOS="550.0" VPOS="2405.0" WIDTH="1586.0" HEIGHT="57.0" WC="0.9860152926134027"/>
          </TextLine>
          <TextLine ID="line_54" TAGREFS="LT8" BASELINE="552 2484 2140 2478" HPOS="550.0" VPOS="2444.0" WIDTH="1590.0" HEIGHT="64.0">
            <Shape><Polygon POINTS="552 2484 552 2508 2138 2496 2140 2478 2134 2444 550 2450 552 2484"/></Shape>
            <String CONTENT="non amplius obligatur primoi non amplius legi eius obſtringitur ſed libera eſt accipe¬" HPOS="550.0" VPOS="2444.0" WIDTH="1590.0" HEIGHT="64.0" WC="0.9942687784516534"/>
          </TextLine>
          <TextLine ID="line_55" TAGREFS="LT8" BASELINE="552 2528 2140 2522" HPOS="550.0" VPOS="2486.0" WIDTH="1590.0" HEIGHT="62.0">
            <Shape><Polygon POINTS="552 2528 552 2548 2138 2540 2140 2522 2134 2486 550 2496 552 2528"/></Shape>
            <String CONTENT="re quem velit. Sed quẽ potius malit:q̃ qui omnes eius ſordes abſterſiti q̃ qui eã ex mor¬" HPOS="550.0" VPOS="2486.0" WIDTH="1590.0" HEIGHT="62.0" WC="0.9886705934346377"/>
          </TextLine>
          <TextLine ID="line_56" TAGREFS="LT8" BASELINE="552 2572 2142 2564" HPOS="550.0" VPOS="2534.0" WIDTH="1592.0" HEIGHT="60.0">
            <Shape><Polygon POINTS="552 2572 552 2594 2140 2584 2142 2564 2136 2534 550 2542 552 2572"/></Shape>
            <String CONTENT="te ſuſcitauit ad vitami q̃ eum qui imortalis eſt et omnia valet et poteſt. cuius prior ſpõ¬" HPOS="550.0" VPOS="2534.0" WIDTH="1592.0" HEIGHT="60.0" WC="0.98295684353165"/>
          </TextLine>
          <TextLine ID="line_57" TAGREFS="LT8" BASELINE="552 2616 2142 2610" HPOS="550.0" VPOS="2580.0" WIDTH="1592.0" HEIGHT="62.0">
            <Shape><Polygon POINTS="552 2616 552 2642 2140 2628 2142 2610 2136 2580 550 2580 552 2616"/></Shape>
            <String CONTENT="ſus gauiſus etiam fuiſſet: poſſe ſumma veſtigia pedum adorare. Hicſponſus eſt im¬" HPOS="550.0" VPOS="2580.0" WIDTH="1592.0" HEIGHT="62.0" WC="0.9951665291079769"/>
          </TextLine>
          <TextLine ID="line_58" TAGREFS="LT8" BASELINE="556 2656 2144 2656" HPOS="556.0" VPOS="2620.0" WIDTH="1588.0" HEIGHT="62.0">
            <Shape><Polygon POINTS="556 2656 556 2682 2144 2676 2144 2656 2142 2620 556 2626 556 2656"/></Shape>
            <String CONTENT="mortalis: et ſponſam immortalem facit. Et ideo hæc lex:inter ſponſum et ſponſam eſt" HPOS="556.0" VPOS="2620.0" WIDTH="1588.0" HEIGHT="62.0" WC="0.9879024122134749"/>
          </TextLine>
          <TextLine ID="line_59" TAGREFS="LT8" BASELINE="556 2702 2146 2702" HPOS="556.0" VPOS="2662.0" WIDTH="1590.0" HEIGHT="61.0">
            <Shape><Polygon POINTS="556 2702 556 2723 2146 2723 2146 2702 2142 2662 556 2666 556 2702"/></Shape>
            <String CONTENT="indiſſolubilis. Sed Moſes ſponſus erat mortalis: et ſynagoga ſponſa mortalis. &amp;" HPOS="556.0" VPOS="2662.0" WIDTH="1590.0" HEIGHT="61.0" WC="0.990945582148395"/>
          </TextLine>
          <TextLine ID="line_60" TAGREFS="LT8" BASELINE="558 2741 2152 2745" HPOS="558.0" VPOS="2711.0" WIDTH="1594.0" HEIGHT="58.0">
            <Shape><Polygon POINTS="558 2741 558 2769 2150 2763 2152 2745 2148 2711 558 2711 558 2741"/></Shape>
            <String CONTENT="ideo lex: inter ſynagogam et Moyſen! ſolubilis! nunc ex alterutra parte ' nunc ex" HPOS="558.0" VPOS="2711.0" WIDTH="1594.0" HEIGHT="58.0" WC="0.9903997646437751"/>
          </TextLine>
          <TextLine ID="line_61" TAGREFS="LT8" BASELINE="560 2789 2154 2785" HPOS="558.0" VPOS="2755.0" WIDTH="1596.0" HEIGHT="56.0">
            <Shape><Polygon POINTS="560 2789 560 2811 2152 2807 2154 2785 2148 2755 558 2757 560 2789"/></Shape>
            <String CONTENT="vtra. Et certe nunc ſoluta eſt ex parte viri:ne iudæi amplius legi carnis aſtringun¬" HPOS="558.0" VPOS="2755.0" WIDTH="1596.0" HEIGHT="56.0" WC="0.9960038253041201"/>
          </TextLine>
          <TextLine ID="line_62" TAGREFS="LT8" BASELINE="556 2833 2160 2833" HPOS="556.0" VPOS="2795.0" WIDTH="1604.0" HEIGHT="88.0">
            <Shape><Polygon POINTS="556 2833 556 2883 666 2865 749 2865 765 2877 767 2877 769 2877 771 2877 773 2877 813 2867 845 2883 847 2883 849 2883 1092 2881 1094 2881 1138 2865 1253 2879 1255 2879 1383 2865 1489 2865 1544 2881 1546 2881 1548 2881 1686 2869 1781 2883 1783 2883 1785 2883 1859 2865 1937 2865 2034 2883 2036 2883 2038 2883 2040 2883 2068 2865 2160 2863 2160 2833 2158 2795 556 2799 556 2833"/></Shape>
            <String CONTENT="tur licet aſtringi ſe credant quia credunt adhuc Moſen legi viuere. ꝙ ſi adhuc legi vi¬" HPOS="556.0" VPOS="2795.0" WIDTH="1604.0" HEIGHT="88.0" WC="0.9949791465682545"/>
          </TextLine>
        </TextBlock>
