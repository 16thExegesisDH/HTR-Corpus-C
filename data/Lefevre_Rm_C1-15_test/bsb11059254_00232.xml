            <String CONTENT="hanc tamen opacã vitã quaſi ſub humo viuebant: nullam apud manes penã ſentiẽtes." HPOS="588.0" VPOS="618.0" WIDTH="1499.0" HEIGHT="78.0" WC="0.9773445512567248"/>
          </TextLine>
