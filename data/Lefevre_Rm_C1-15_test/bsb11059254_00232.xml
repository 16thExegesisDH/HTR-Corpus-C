            <String CONTENT="matã vitam quæ eſt in planta. &amp; vt vita granis opaca eſt &amp; humo ſuffoſſa: ita &amp; vitaq̃" HPOS="588.0" VPOS="535.0" WIDTH="1499.0" HEIGHT="73.0" WC="0.984919396625168"/>
