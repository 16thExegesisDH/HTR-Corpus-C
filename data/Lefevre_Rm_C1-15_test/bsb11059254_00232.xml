            <String CONTENT="ſed meliorem &amp; lucidã expectantes vitam: quã Chriſtus ſæculorũ rex &amp; dominus illis" HPOS="584.0" VPOS="662.0" WIDTH="1505.0" HEIGHT="76.0" WC="0.9923652270260979"/>
          </TextLine>
          <TextLine ID="line_13" TAGREFS="LT8" BASELINE="586 748 2091 762" HPOS="584.0" VPOS="714.0" WIDTH="1507.0" HEIGHT="64.0">
