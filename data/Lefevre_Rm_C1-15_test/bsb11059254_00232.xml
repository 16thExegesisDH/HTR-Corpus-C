            <String CONTENT="attulit. Deſierunt protinus illa vita legis viuere: lucida iam viuẽtes vitar &amp; ea quæ" HPOS="584.0" VPOS="714.0" WIDTH="1507.0" HEIGHT="64.0" WC="0.9863762081354513"/>
          </TextLine>
          <TextLine ID="line_14" TAGREFS="LT8" BASELINE="584 792 2091 808" HPOS="582.0" VPOS="758.0" WIDTH="1509.0" HEIGHT="64.0">
            <Shape><Polygon POINTS="584 792 582 806 2087 822 2091 808 2089 774 584 758 584 792"/></Shape>
            <String CONTENT="ex gratia eſt! &amp; regionis lucis. Quo modo enim opaca ſimul viuerẽt &amp; lucida! Sed nõ¬" HPOS="582.0" VPOS="758.0" WIDTH="1509.0" HEIGHT="64.0" WC="0.995059434064599"/>
          </TextLine>
          <TextLine ID="line_15" TAGREFS="LT8" BASELINE="584 834 2089 852" HPOS="582.0" VPOS="794.0" WIDTH="1507.0" HEIGHT="78.0">
            <Shape><Polygon POINTS="584 834 582 850 2085 872 2089 852 2087 814 584 794 584 834"/></Shape>
            <String CONTENT="ne attendis: quando nõ eſt opus præcepto medicil ꝙ infirmitas nulla eſt? Sic quando" HPOS="582.0" VPOS="794.0" WIDTH="1507.0" HEIGHT="78.0" WC="0.9986091256141663"/>
          </TextLine>
          <TextLine ID="line_16" TAGREFS="LT8" BASELINE="584 880 2089 894" HPOS="582.0" VPOS="848.0" WIDTH="1507.0" HEIGHT="63.0">
