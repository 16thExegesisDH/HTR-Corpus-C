            <String CONTENT="catumi nõdum carne ægrotãt. ſed vt Adam: primũ incipient carne ægrotarel cũ ſenſũ" HPOS="588.0" VPOS="890.0" WIDTH="1503.0" HEIGHT="69.0" WC="0.9914221950741702"/>
          </TextLine>
          <TextLine ID="line_18" TAGREFS="LT8" BASELINE="588 967 2091 987" HPOS="586.0" VPOS="925.0" WIDTH="1505.0" HEIGHT="78.0">
            <Shape><Polygon POINTS="588 967 586 991 2087 1003 2091 987 2089 953 588 925 588 967"/></Shape>
            <String CONTENT="boni &amp; mali habebunt, tũc cõcupiſcẽtię infirmitatis ſuæ ſurgent. tũc opus eſt lege:quæ" HPOS="586.0" VPOS="925.0" WIDTH="1505.0" HEIGHT="78.0" WC="0.9940488037172255"/>
          </TextLine>
          <TextLine ID="line_19" TAGREFS="LT8" BASELINE="588 1011 2093 1029" HPOS="586.0" VPOS="979.0" WIDTH="1507.0" HEIGHT="68.0">
            <Shape><Polygon POINTS="588 1011 586 1029 2089 1047 2093 1029 2093 997 588 979 588 1011"/></Shape>
            <String CONTENT="mala vetet &amp; bona pręcipiat. quã ſi ſequentur: viuẽt legil vitam ſubinde gratiæ opti¬" HPOS="586.0" VPOS="979.0" WIDTH="1507.0" HEIGHT="68.0" WC="0.984508909962394"/>
          </TextLine>
          <TextLine ID="line_20" TAGREFS="LT8" BASELINE="588 1055 2093 1075" HPOS="586.0" VPOS="1023.0" WIDTH="1507.0" HEIGHT="74.0">
            <Shape><Polygon POINTS="588 1055 586 1071 2089 1097 2093 1075 2091 1043 588 1023 588 1055"/></Shape>
            <String CONTENT="mam percepturi. ſi nõ ſequentur: lex quę bona eratl occaſionaliter erit eis ad mortem" HPOS="586.0" VPOS="1023.0" WIDTH="1507.0" HEIGHT="74.0" WC="0.993734042534883"/>
          </TextLine>
          <TextLine ID="line_21" TAGREFS="LT8" BASELINE="592 1099 2093 1121" HPOS="590.0" VPOS="1059.0" WIDTH="1503.0" HEIGHT="80.0">
            <Shape><Polygon POINTS="592 1099 590 1115 2089 1139 2093 1121 2091 1087 592 1059 592 1099"/></Shape>
            <String CONTENT="legis &amp; ſubinde ad mortẽ exteriorũ tenebrarũ quæ optimę opponitur vitæ. Ergo ante" HPOS="590.0" VPOS="1059.0" WIDTH="1503.0" HEIGHT="80.0" WC="0.988024384133956"/>
          </TextLine>
          <TextLine ID="line_22" TAGREFS="LT8" BASELINE="589 1144 2091 1165" HPOS="584" VPOS="1098" WIDTH="1505" HEIGHT="84">
            <Shape><Polygon POINTS="2062 1119 1460 1113 1430 1110 1249 1110 1219 1107 1038 1107 1008 1104 617 1101 587 1098 587 1143 584 1161 2083 1182 2089 1164 2086 1119 2062 1119"/></Shape>
            <String CONTENT="tempus legis mortui erãt peccatol &amp; peccatũ in eis mortuũ. Cũ autẽ aduenit tẽpus quo" HPOS="584" VPOS="1098" WIDTH="1505" HEIGHT="84" WC="0.9958997375435299"/>
          </TextLine>
          <TextLine ID="line_23" TAGREFS="LT8" BASELINE="568 1189 2095 1210" HPOS="566.0" VPOS="1155.0" WIDTH="1529.0" HEIGHT="73.0">
            <Shape><Polygon POINTS="568 1189 566 1212 2091 1228 2095 1210 2095 1171 568 1155 568 1189"/></Shape>
            <String CONTENT=",opus eſt lege: peccatum ſuſcitatur. Quæ inſinuat Paulus dicens. ¶Sine lege enim" HPOS="566.0" VPOS="1155.0" WIDTH="1529.0" HEIGHT="73.0" WC="0.98999447748065"/>
          </TextLine>
          <TextLine ID="line_24" TAGREFS="LT8" BASELINE="568 1232 2093 1252" HPOS="566.0" VPOS="1199.0" WIDTH="1527.0" HEIGHT="71.0">
            <Shape><Polygon POINTS="568 1232 566 1256 2089 1270 2093 1252 2091 1220 568 1199 568 1232"/></Shape>
            <String CONTENT=",peccatum mortuum erat: ego autem viuebam ſine lege aliquando. ſed cum veniſſet" HPOS="566.0" VPOS="1199.0" WIDTH="1527.0" HEIGHT="71.0" WC="0.9962680950949464"/>
          </TextLine>
          <TextLine ID="line_25" TAGREFS="LT8" BASELINE="566 1278 2091 1296" HPOS="564.0" VPOS="1242.0" WIDTH="1527.0" HEIGHT="70.0">
            <Shape><Polygon POINTS="566 1278 564 1302 2087 1312 2091 1296 2089 1266 566 1242 566 1278"/></Shape>
            <String CONTENT=",mandatum: peccatum reuixit. ego autem mortuus eram. &amp; inuentum eſt michi mã¬" HPOS="564.0" VPOS="1242.0" WIDTH="1527.0" HEIGHT="70.0" WC="0.9770934398357685"/>
          </TextLine>
          <TextLine ID="line_26" TAGREFS="LT8" BASELINE="574 1322 2093 1340" HPOS="572.0" VPOS="1290.0" WIDTH="1521.0" HEIGHT="72.0">
            <Shape><Polygon POINTS="574 1322 572 1346 2089 1362 2093 1340 2091 1306 574 1290 574 1322"/></Shape>
            <String CONTENT="datum quod erat ad vitam: hoc fuiſſe ad mortem. Nam peccatum occaſionem accipi¬" HPOS="572.0" VPOS="1290.0" WIDTH="1521.0" HEIGHT="72.0" WC="0.9916064354437816"/>
          </TextLine>
          <TextLine ID="line_27" TAGREFS="LT8" BASELINE="572 1366 2093 1382" HPOS="570.0" VPOS="1334.0" WIDTH="1523.0" HEIGHT="72.0">
            <Shape><Polygon POINTS="572 1366 570 1392 2089 1406 2093 1382 2091 1352 572 1334 572 1366"/></Shape>
            <String CONTENT=",ens: per mandatum ſeduxit mel &amp; per illud occidit. Ita lex quidem ſancta: &amp; man" HPOS="570.0" VPOS="1334.0" WIDTH="1523.0" HEIGHT="72.0" WC="0.9949960222950688"/>
          </TextLine>
          <TextLine ID="line_28" TAGREFS="LT8" BASELINE="582 1410 2093 1428" HPOS="580.0" VPOS="1378.0" WIDTH="1513.0" HEIGHT="72.0">
            <Shape><Polygon POINTS="582 1410 580 1434 2089 1450 2093 1428 2091 1396 582 1378 582 1410"/></Shape>
            <String CONTENT="datum ſanctum et iuſtum &amp; bonum. Quod ergo bonum eſt: michi factũ eſt mors? Ab¬" HPOS="580.0" VPOS="1378.0" WIDTH="1513.0" HEIGHT="72.0" WC="0.9893916346132755"/>
          </TextLine>
          <TextLine ID="line_29" TAGREFS="LT8" BASELINE="574 1456 2091 1474" HPOS="572.0" VPOS="1424.0" WIDTH="1519.0" HEIGHT="66.0">
            <Shape><Polygon POINTS="574 1456 572 1480 2087 1490 2091 1474 2089 1442 574 1424 574 1456"/></Shape>
            <String CONTENT="ſit. ſed peccatũ vt appareat peccatũ: per bonũ michi operatũ ẽ mortẽ vt fiat ſupra mo¬" HPOS="572.0" VPOS="1424.0" WIDTH="1519.0" HEIGHT="66.0" WC="0.9914140370876893"/>
          </TextLine>
          <TextLine ID="line_30" TAGREFS="LT8" BASELINE="580 1498 2093 1519" HPOS="578.0" VPOS="1466.0" WIDTH="1515.0" HEIGHT="71.0">
            <Shape><Polygon POINTS="580 1498 578 1517 2089 1537 2093 1519 2091 1486 580 1466 580 1498"/></Shape>
            <String CONTENT="dum peccãs peccatũ per mãdatũ. (J Morbus ſe maxime declarat eſſe morbum: quanto" HPOS="578.0" VPOS="1466.0" WIDTH="1515.0" HEIGHT="71.0" WC="0.98583733604615"/>
          </TextLine>
          <TextLine ID="line_31" TAGREFS="LT8" BASELINE="584 1541 2095 1563" HPOS="582.0" VPOS="1509.0" WIDTH="1513.0" HEIGHT="72.0">
            <Shape><Polygon POINTS="584 1541 582 1563 2091 1581 2095 1563 2095 1527 584 1509 584 1541"/></Shape>
            <String CONTENT="magis nititur ĩ vetita! &amp; fugit commendata! &amp; occaſionem accipit a præceptis medici" HPOS="582.0" VPOS="1509.0" WIDTH="1513.0" HEIGHT="72.0" WC="0.9884449491898218"/>
          </TextLine>
          <TextLine ID="line_32" TAGREFS="LT8" BASELINE="586 1587 2093 1607" HPOS="584.0" VPOS="1549.0" WIDTH="1509.0" HEIGHT="76.0">
            <Shape><Polygon POINTS="586 1587 584 1605 2089 1625 2093 1607 2091 1575 586 1549 586 1587"/></Shape>
            <String CONTENT="quæ bona &amp; ſalutaria erantivt citius interficiat! &amp; fiat (vt ſic dicam) morbidior mot¬" HPOS="584.0" VPOS="1549.0" WIDTH="1509.0" HEIGHT="76.0" WC="0.9922226868396582"/>
          </TextLine>
          <TextLine ID="line_33" TAGREFS="LT8" BASELINE="586 1629 2095 1651" HPOS="584.0" VPOS="1591.0" WIDTH="1511.0" HEIGHT="78.0">
            <Shape><Polygon POINTS="586 1629 584 1647 2091 1669 2095 1651 2093 1621 586 1591 586 1629"/></Shape>
            <String CONTENT="bus. &amp; ſic eſt de peccato. Sed cum morb9 vt febris calefaciat: quid nã iubebit lex febris" HPOS="584.0" VPOS="1591.0" WIDTH="1511.0" HEIGHT="78.0" WC="0.9977119525273641"/>
          </TextLine>
          <TextLine ID="line_34" TAGREFS="LT8" BASELINE="584 1675 2095 1695" HPOS="582.0" VPOS="1641.0" WIDTH="1513.0" HEIGHT="72.0">
            <Shape><Polygon POINTS="584 1675 582 1695 2091 1713 2095 1695 2093 1665 584 1641 584 1675"/></Shape>
            <String CONTENT="data a medico? Procul dubio: infrigidare. ſi frigefaciat vt paralyſis: nõne oportet cale" HPOS="582.0" VPOS="1641.0" WIDTH="1513.0" HEIGHT="72.0" WC="0.9826504105932257"/>
