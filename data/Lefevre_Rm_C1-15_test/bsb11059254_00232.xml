            <String CONTENT="peccatũ nullũ eſt: lege nõ eſt opus. vt pueris lege nõ eſt opus: quia nondũ habent pec¬" HPOS="582.0" VPOS="848.0" WIDTH="1507.0" HEIGHT="63.0" WC="0.9871092795029931"/>
          </TextLine>
          <TextLine ID="line_17" TAGREFS="LT8" BASELINE="590 923 2091 943" HPOS="588.0" VPOS="890.0" WIDTH="1503.0" HEIGHT="69.0">
