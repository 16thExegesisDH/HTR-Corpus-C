            <String CONTENT="ex lege &amp; operibus ẽ opaca eſt &amp; qui ea vita &amp; in eis viuebãt: deſcendebãt ad inferos." HPOS="590.0" VPOS="579.0" WIDTH="1499.0" HEIGHT="73.0" WC="0.990472863229473"/>
          </TextLine>
          <TextLine ID="line_11" TAGREFS="LT8" BASELINE="590 660 2087 676" HPOS="588.0" VPOS="618.0" WIDTH="1499.0" HEIGHT="78.0">
