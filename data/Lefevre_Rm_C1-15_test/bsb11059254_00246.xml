            <Shape><Polygon POINTS="551 553 549 573 2125 579 2129 561 2127 529 551 515 551 553"/></Shape>
            <String CONTENT="rat: quid igitur amplius accuſantur indurati ? id enim voluntas dei eſt: cui nichil reſi¬" HPOS="549.0" VPOS="515.0" WIDTH="1580.0" HEIGHT="64.0" WC="0.9996382969149044"/>
          </TextLine>
          <TextLine ID="line_9" TAGREFS="LT8" BASELINE="551 597 2125 607" HPOS="549.0" VPOS="559.0" WIDTH="1576.0" HEIGHT="64.0">
            <Shape><Polygon POINTS="551 597 549 613 2121 623 2125 607 2125 573 551 559 551 597"/></Shape>
            <String CONTENT="ſtere poteſt. imo cur puniuntur: cũ id ſint quod deus vult! Hoc argumentum impie¬" HPOS="549.0" VPOS="559.0" WIDTH="1576.0" HEIGHT="64.0" WC="0.9851029500728701"/>
          </TextLine>
          <TextLine ID="line_10" TAGREFS="LT8" BASELINE="551 645 2121 651" HPOS="549.0" VPOS="603.0" WIDTH="1572.0" HEIGHT="64.0">
