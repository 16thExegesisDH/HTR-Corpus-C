            <String CONTENT="Et deterret Paulus rudes &amp; ſtultos ab huiuſmodi impia contra deum cõtentione, nant" HPOS="547.0" VPOS="653.0" WIDTH="1580.0" HEIGHT="60.0" WC="0.9925251581582678"/>
          </TextLine>
          <TextLine ID="line_12" TAGREFS="LT8" BASELINE="545 731 2123 737" HPOS="543.0" VPOS="695.0" WIDTH="1580.0" HEIGHT="66.0">
