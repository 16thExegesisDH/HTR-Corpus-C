            <String CONTENT="ſapientes &amp; probos non oportet! qui tales cogitatus nõ admittunt aut continuo ene¬" HPOS="543.0" VPOS="695.0" WIDTH="1580.0" HEIGHT="66.0" WC="0.9781498334493982"/>
          </TextLine>
          <TextLine ID="line_13" TAGREFS="LT8" BASELINE="543 775 2123 783" HPOS="541.0" VPOS="745.0" WIDTH="1582.0" HEIGHT="56.0">
            <Shape><Polygon POINTS="543 775 541 793 2119 801 2123 783 2111 751 543 745 543 775"/></Shape>
            <String CONTENT="cant tanq̃ venenoſos ſerpentes. ſunt enim afflatus ſerpentis antiqui: animã corrumpẽ¬" HPOS="541.0" VPOS="745.0" WIDTH="1582.0" HEIGHT="56.0" WC="0.9946296036928549"/>
          </TextLine>
          <TextLine ID="line_14" TAGREFS="LT8" BASELINE="563 823 2117 831" HPOS="559" VPOS="778" WIDTH="1557" HEIGHT="69">
            <Shape><Polygon POINTS="562 820 559 844 2110 847 2116 829 2113 790 562 778 562 820"/></Shape>
            <String CONTENT="tes. deterret inquam Paulus ex proportione figuli &amp; vaſorum figuli ad figulum dicẽs." HPOS="559" VPOS="778" WIDTH="1557" HEIGHT="69" WC="0.991545569896698"/>
          </TextLine>
          <TextLine ID="line_15" TAGREFS="LT8" BASELINE="513 865 2119 875" HPOS="511.0" VPOS="833.0" WIDTH="1608.0" HEIGHT="58.0">
            <Shape><Polygon POINTS="513 865 511 881 2115 891 2119 875 2117 833 513 833 513 865"/></Shape>
            <String CONTENT="„(¶ Dicis ita michi: quid adhuc accuſatur? volũtati eni eius quis reſiſtit? Quinimo. O" HPOS="511.0" VPOS="833.0" WIDTH="1608.0" HEIGHT="58.0" WC="0.9823762280019847"/>
          </TextLine>
          <TextLine ID="line_16" TAGREFS="LT8" BASELINE="515 912 2121 920" HPOS="513.0" VPOS="869.0" WIDTH="1608.0" HEIGHT="67.0">
            <Shape><Polygon POINTS="515 912 513 928 2117 936 2121 920 2119 885 515 869 515 912"/></Shape>
            <String CONTENT=",homo tu quis es: qui contra reſpõdeas deo? Nunquid dicit figmentũ ei qui finxit: quid" HPOS="513.0" VPOS="869.0" WIDTH="1608.0" HEIGHT="67.0" WC="0.9840667782859369"/>
          </TextLine>
          <TextLine ID="line_17" TAGREFS="LT8" BASELINE="509 956 2117 966" HPOS="507.0" VPOS="922.0" WIDTH="1610.0" HEIGHT="66.0">
            <Shape><Polygon POINTS="509 956 507 978 2113 988 2117 966 2115 924 509 922 509 956"/></Shape>
            <String CONTENT=",me feciſti fic ( An nõ habet poteſtatem figulus luti: ex eadem maſſa facere hoc quidem" HPOS="507.0" VPOS="922.0" WIDTH="1610.0" HEIGHT="66.0" WC="0.9905878508632834"/>
          </TextLine>
