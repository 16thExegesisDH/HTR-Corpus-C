            <Shape><Polygon POINTS="521 1000 519 1022 2111 1026 2115 1010 2113 978 521 964 521 1000"/></Shape>
            <String CONTENT=",vas ad honorem illud vero ad inhonorationẽ? (j Hæc eſt prima Pauli maxime ad ru¬" HPOS="519.0" VPOS="964.0" WIDTH="1596.0" HEIGHT="62.0" WC="0.985959867878658"/>
          </TextLine>
          <TextLine ID="line_19" TAGREFS="LT8" BASELINE="541 1042 2117 1054" HPOS="539.0" VPOS="1010.0" WIDTH="1578.0" HEIGHT="60.0">
            <Shape><Polygon POINTS="541 1042 539 1060 2113 1070 2117 1054 2115 1020 541 1010 541 1042"/></Shape>
            <String CONTENT="des queſtionis dilutio: ſic ſcilicet contra deum non eſſe altercandum impiei ſiue hunc" HPOS="539.0" VPOS="1010.0" WIDTH="1578.0" HEIGHT="60.0" WC="0.9855083227157593"/>
          </TextLine>
          <TextLine ID="line_20" TAGREFS="LT8" BASELINE="543 1086 2113 1098" HPOS="541.0" VPOS="1054.0" WIDTH="1572.0" HEIGHT="62.0">
            <Shape><Polygon POINTS="543 1086 541 1104 2109 1116 2113 1098 2111 1066 543 1054 543 1086"/></Shape>
            <String CONTENT="ad miſericordiam! &amp; illum ad iuſtitiam ſuam facit. Et placet deo miſereri: &amp; placet deo" HPOS="541.0" VPOS="1054.0" WIDTH="1572.0" HEIGHT="62.0" WC="0.9799646659829151"/>
          </TextLine>
          <TextLine ID="line_21" TAGREFS="LT8" BASELINE="533 1130 2113 1142" HPOS="531.0" VPOS="1098.0" WIDTH="1582.0" HEIGHT="62.0">
            <Shape><Polygon POINTS="533 1130 531 1148 2109 1160 2113 1142 2111 1112 533 1098 533 1130"/></Shape>
            <String CONTENT="punire. ſod vita in voluntate eius: &amp; ira in indignatione eius. immo et cum punit mi¬" HPOS="531.0" VPOS="1098.0" WIDTH="1582.0" HEIGHT="62.0" WC="0.9925434182671939"/>
          </TextLine>
          <TextLine ID="line_22" TAGREFS="LT8" BASELINE="539 1174 2111 1186" HPOS="537.0" VPOS="1144.0" WIDTH="1574.0" HEIGHT="60.0">
            <Shape><Polygon POINTS="539 1174 537 1192 2107 1204 2111 1186 2109 1148 539 1144 539 1174"/></Shape>
            <String CONTENT="ſericors eſt: &amp; cum miſeretur iuſtus. Sed tu cũ peccas: non vis accuſari non vis puniri." HPOS="537.0" VPOS="1144.0" WIDTH="1574.0" HEIGHT="60.0" WC="0.9832872862226507"/>
          </TextLine>
          <TextLine ID="line_23" TAGREFS="LT8" BASELINE="541 1220 2111 1230" HPOS="539.0" VPOS="1186.0" WIDTH="1572.0" HEIGHT="62.0">
            <Shape><Polygon POINTS="541 1220 539 1238 2107 1248 2111 1230 2109 1200 541 1186 541 1220"/></Shape>
            <String CONTENT="verum ideo accuſaris: quia ſponte tua peccas &amp; paratum erat diuinum auxilium vt in¬" HPOS="539.0" VPOS="1186.0" WIDTH="1572.0" HEIGHT="62.0" WC="0.9975499453314816"/>
          </TextLine>
          <TextLine ID="line_24" TAGREFS="LT8" BASELINE="539 1262 2113 1276" HPOS="537.0" VPOS="1230.0" WIDTH="1576.0" HEIGHT="70.0">
            <Shape><Polygon POINTS="539 1262 537 1280 2109 1300 2113 1276 2111 1240 539 1230 539 1262"/></Shape>
            <String CONTENT="firmitatem tuam adiuuaret ne peccares. &amp; ideo puniris: quia deus iuſtus eſt ne eius" HPOS="537.0" VPOS="1230.0" WIDTH="1576.0" HEIGHT="70.0" WC="0.9963988640478679"/>
          </TextLine>
          <TextLine ID="line_25" TAGREFS="LT8" BASELINE="541 1308 2113 1320" HPOS="539.0" VPOS="1268.0" WIDTH="1574.0" HEIGHT="70.0">
            <Shape><Polygon POINTS="541 1308 539 1326 2109 1338 2113 1320 2111 1286 541 1268 541 1308"/></Shape>
            <String CONTENT="ipſius! ſed tua volũtate peccas. Vult eni te bonum eſſe: &amp; ſemper ad hoc te adiuuat, &amp;" HPOS="539.0" VPOS="1268.0" WIDTH="1574.0" HEIGHT="70.0" WC="0.9888686476082638"/>
          </TextLine>
          <TextLine ID="line_26" TAGREFS="LT8" BASELINE="531 1355 2111 1365" HPOS="529.0" VPOS="1318.0" WIDTH="1582.0" HEIGHT="67.0">
            <Shape><Polygon POINTS="531 1355 529 1371 2107 1385 2111 1365 2111 1332 531 1318 531 1355"/></Shape>
            <String CONTENT="tua voluntas! tui peccati &amp; tuę indurationis per ſe cauſa eſt: &amp; non dei volũtas niſi for" HPOS="529.0" VPOS="1318.0" WIDTH="1582.0" HEIGHT="67.0" WC="0.98413323701083"/>
          </TextLine>
          <TextLine ID="line_27" TAGREFS="LT8" BASELINE="535 1399 2113 1411" HPOS="533.0" VPOS="1361.0" WIDTH="1580.0" HEIGHT="68.0">
            <Shape><Polygon POINTS="535 1399 533 1415 2109 1429 2113 1411 2111 1371 535 1361 535 1399"/></Shape>
            <String CONTENT="te per accidens &amp; permiſſiue cauſam dicere velis ſed hoc nõ eſt eſſe cauſam. Vult enim" HPOS="533.0" VPOS="1361.0" WIDTH="1580.0" HEIGHT="68.0" WC="0.9930890065500106"/>
          </TextLine>
          <TextLine ID="line_28" TAGREFS="LT8" BASELINE="535 1441 2113 1453" HPOS="533.0" VPOS="1409.0" WIDTH="1580.0" HEIGHT="64.0">
            <Shape><Polygon POINTS="535 1441 533 1459 2109 1473 2113 1453 2111 1423 535 1409 535 1441"/></Shape>
            <String CONTENT="deus omnes homines ſaluos fieri: &amp; multo magis q̃ pater proprios filios! quippe qui fe" HPOS="533.0" VPOS="1409.0" WIDTH="1580.0" HEIGHT="64.0" WC="0.9890798773876456"/>
          </TextLine>
          <TextLine ID="line_29" TAGREFS="LT8" BASELINE="535 1487 2113 1499" HPOS="533.0" VPOS="1457.0" WIDTH="1580.0" HEIGHT="58.0">
            <Shape><Polygon POINTS="535 1487 533 1503 2109 1515 2113 1499 2111 1461 535 1457 535 1487"/></Shape>
            <String CONTENT="cit! &amp; creauit nos. Et quo modo vellet nos peccare: cum de co dicat diuinus ſermoſnõ" HPOS="533.0" VPOS="1457.0" WIDTH="1580.0" HEIGHT="58.0" WC="0.9901239374104668"/>
          </TextLine>
          <TextLine ID="line_30" TAGREFS="LT8" BASELINE="535 1529 2113 1543" HPOS="533.0" VPOS="1499.0" WIDTH="1580.0" HEIGHT="62.0">
            <Shape><Polygon POINTS="535 1529 533 1547 2109 1561 2113 1543 2111 1505 535 1499 535 1529"/></Shape>
            <String CONTENT="deus volens iniquitatem tu es? Si igitur peccas: contra eius voluntatem peccas. ſi autẽ" HPOS="533.0" VPOS="1499.0" WIDTH="1580.0" HEIGHT="62.0" WC="0.9919732185927305"/>
          </TextLine>
          <TextLine ID="line_31" TAGREFS="LT8" BASELINE="533 1575 2113 1589" HPOS="531.0" VPOS="1537.0" WIDTH="1582.0" HEIGHT="68.0">
            <Shape><Polygon POINTS="533 1575 531 1595 2109 1605 2113 1589 2111 1553 533 1537 533 1575"/></Shape>
            <String CONTENT="bene agis: ſecundum voluntatem eius agis. vult enim te bene agere, ſed libere. ideo nõ" HPOS="531.0" VPOS="1537.0" WIDTH="1582.0" HEIGHT="68.0" WC="0.9951558907826742"/>
          </TextLine>
          <TextLine ID="line_32" TAGREFS="LT8" BASELINE="533 1617 2109 1637" HPOS="531.0" VPOS="1585.0" WIDTH="1578.0" HEIGHT="70.0">
            <Shape><Polygon POINTS="533 1617 531 1637 2105 1655 2109 1637 2107 1597 533 1585 533 1617"/></Shape>
            <String CONTENT="inducit tibi ad bene agendũ neceſſitatẽ:et multo minus ad male agẽdũ. Quo modo igi" HPOS="531.0" VPOS="1585.0" WIDTH="1578.0" HEIGHT="70.0" WC="0.9903826741285102"/>
          </TextLine>
          <TextLine ID="line_33" TAGREFS="LT8" BASELINE="535 1663 2109 1679" HPOS="533.0" VPOS="1633.0" WIDTH="1576.0" HEIGHT="62.0">
            <Shape><Polygon POINTS="535 1663 533 1687 2105 1695 2109 1679 2107 1649 535 1633 535 1663"/></Shape>
            <String CONTENT="tur contra deum dicit impius ſi cuius vult miſeretur et quem vult indurat volũtati eius" HPOS="533.0" VPOS="1633.0" WIDTH="1576.0" HEIGHT="62.0" WC="0.9908312633633614"/>
          </TextLine>
          <TextLine ID="line_34" TAGREFS="LT8" BASELINE="533 1705 2107 1721" HPOS="531.0" VPOS="1677.0" WIDTH="1576.0" HEIGHT="64.0">
            <Shape><Polygon POINTS="533 1705 531 1723 2103 1741 2107 1721 2105 1693 533 1677 533 1705"/></Shape>
            <String CONTENT="quis reſiſtit: quaſi ſi malus ſit: velit eum deus neceſſario peccare, cum ne velit eum:" HPOS="531.0" VPOS="1677.0" WIDTH="1576.0" HEIGHT="64.0" WC="0.9975285990671678"/>
          </TextLine>
          <TextLine ID="line_35" TAGREFS="LT8" BASELINE="535 1753 2111 1767" HPOS="533.0" VPOS="1715.0" WIDTH="1578.0" HEIGHT="68.0">
            <Shape><Polygon POINTS="535 1753 533 1775 2107 1783 2111 1767 2111 1735 535 1715 535 1753"/></Shape>
            <String CONTENT="ne neceſſarioſ ne libere peccare. &amp; quaſi ſi quis bonus ſit: velit eum neceſſario bonũ" HPOS="533.0" VPOS="1715.0" WIDTH="1578.0" HEIGHT="68.0" WC="0.9955833319867595"/>
          </TextLine>
