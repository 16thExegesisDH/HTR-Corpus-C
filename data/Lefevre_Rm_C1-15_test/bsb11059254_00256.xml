            <String CONTENT="eius fuit? ex Eſaia aut ex libro ſapientiæ mutuatũ videtur. Si ex libro ſapientiæ: con¬" HPOS="576.0" VPOS="463.0" WIDTH="1591.0" HEIGHT="56.0" WC="0.985564336180687"/>
